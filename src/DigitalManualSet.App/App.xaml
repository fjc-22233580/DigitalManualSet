<Application
    x:Class="DigitalManualSet.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DigitalManualSet.App.Views.Common.Converters">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--  Import fluent styles so UI is inline with WIN11  -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />

                <!--  Import data templates to enable global UI - VM resolution  -->
                <ResourceDictionary Source="/Resources/DataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />

            <!--
                ContainerStyle: used to visually group related settings with consistent
                background, border and corner radius.
            -->
            <Style x:Key="ContainerStyle" TargetType="{x:Type Border}">

                <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ExpanderHeaderBorderBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource ExpanderBorderThemeThickness}" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />

            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
