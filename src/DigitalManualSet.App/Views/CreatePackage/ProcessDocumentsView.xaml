<UserControl
    x:Class="DigitalManualSet.App.Views.CreatePackage.ProcessDocumentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:createPackage="clr-namespace:DigitalManualSet.App.ViewModels.CreatePackage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DigitalManualSet.App.Views.CreatePackage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance createPackage:ProcessDocumentsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0" Text="Document Source:" />

            <Border
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="DarkGray"
                BorderThickness="{StaticResource ExpanderBorderThemeThickness}"
                CornerRadius="{StaticResource OverlayCornerRadius}">

                <DockPanel LastChildFill="False">


                    <StackPanel Margin="0,0,12,0" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filename: " />
                            <TextBlock Text="{Binding DocumentsFilename}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DocumentCount}" />
                            <TextBlock Text=" documents imported" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right">

                        <TextBlock Text="Working folder: " />
                        <TextBlock>
                            <Hyperlink Command="{Binding OpenDestinationFolder}">
                                <Run Text="{Binding DestinationFolder, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>


                    </StackPanel>

                </DockPanel>
            </Border>

        </Grid>


        <Grid Grid.Row="1" Margin="0,20,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Documents:" />



            <Border
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="DarkGray"
                BorderThickness="{StaticResource ExpanderBorderThemeThickness}"
                CornerRadius="{StaticResource OverlayCornerRadius}">


                <ScrollViewer>

                    <Grid Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <Grid Grid.Row="0" Margin="12,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="NumColumn" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DocNumberColumn" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="NameColumn" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="RevisionColumn" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CategoryColumn" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatusColumn" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                Text="Document No." />

                            <TextBlock
                                Grid.Column="2"
                                Margin="12,0"
                                FontWeight="SemiBold"
                                Text="Document Name" />

                            <TextBlock
                                Grid.Column="3"
                                Margin="13,0,0,0"
                                FontWeight="SemiBold"
                                Text="Revision" />

                            <TextBlock
                                Grid.Column="4"
                                Margin="13,0,0,0"
                                FontWeight="SemiBold"
                                Text="Category" />

                            <TextBlock
                                Grid.Column="5"
                                Margin="13,0,0,0"
                                FontWeight="SemiBold"
                                Text="Status" />
                        </Grid>



                        <ItemsControl Grid.Row="1" ItemsSource="{Binding AvailableDocuments}">


                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:DocumentRowView DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Grid>
                </ScrollViewer>


            </Border>


        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">

            <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding DownloadStatus}" />


            </Grid>

            <ProgressBar
                Maximum="100"
                Minimum="0"
                Value="{Binding OverallProgress}" />
        </StackPanel>


        <Button
            Grid.Row="3"
            Margin="12"
            HorizontalAlignment="Center"
            Command="{Binding BeginDownloadCommand}"
            Content="Download all" />

    </Grid>

</UserControl>
