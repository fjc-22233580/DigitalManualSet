<UserControl
    x:Class="DigitalManualSet.App.Views.CreatePackage.DocumentRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:createPackage="clr-namespace:DigitalManualSet.App.ViewModels.CreatePackage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance createPackage:DocumentRowViewModel}"
    mc:Ignorable="d">

    <Border Height="38" Style="{StaticResource ContainerStyle}">


        <Grid Margin="12,0,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="NumColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="DocNumberColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="NameColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="RevisionColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="CategoryColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="StatusColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="DeleteColumn" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="{Binding RowNumber}" />

            <TextBlock
                Grid.Column="1"
                Margin="0,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding DocumentNumber}" />
            <TextBlock
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding DocumentName}" />
            <TextBlock
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Revision}" />

            <TextBlock
                Grid.Column="4"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Category}" />

            <TextBlock
                Grid.Column="5"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Status}" />

            <Button
                Grid.Column="6"
                Width="28"
                Height="28"
                Margin="12,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding DeleteDocumentCommand}"
                Style="{StaticResource SmallIconButtonStyle}"
                ToolTip="Delete"
                Visibility="{Binding IsManuallyAdded, Converter={StaticResource BoolToVisibility}}">

                <TextBlock
                    FontFamily="Segoe Fluent Icons"
                    FontSize="14"
                    Text="&#xE74D;" />

            </Button>
        </Grid>
    </Border>
</UserControl>
