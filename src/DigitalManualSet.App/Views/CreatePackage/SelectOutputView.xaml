<UserControl
    x:Class="DigitalManualSet.App.Views.CreatePackage.SelectOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:createPackage="clr-namespace:DigitalManualSet.App.ViewModels.CreatePackage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance createPackage:SelectOutputViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Thickness x:Key="ColumnMargin">20,0,0,0</Thickness>
    </UserControl.Resources>

    <Grid IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Margin="0,8,8,8"
            Command="{Binding RefreshDrivesCommand}"
            Content="Refresh" />

        <Grid Grid.Row="1" Margin="18,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DriveColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="ModelColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="CapacityColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="WriteStatusColumn" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="IsEmptyColumn" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                FontWeight="SemiBold"
                Text="Drive:" />

            <TextBlock
                Grid.Column="1"
                Margin="{DynamicResource ColumnMargin}"
                FontWeight="SemiBold"
                Text="Model:" />

            <TextBlock
                Grid.Column="2"
                Margin="{DynamicResource ColumnMargin}"
                FontWeight="SemiBold"
                Text="Volume Label:" />

            <TextBlock
                Grid.Column="3"
                Margin="{DynamicResource ColumnMargin}"
                FontWeight="SemiBold"
                Text="Capacity:" />

            <TextBlock
                Grid.Column="4"
                Margin="{DynamicResource ColumnMargin}"
                FontWeight="SemiBold"
                Text="Write Status:" />

            <TextBlock
                Grid.Column="5"
                Margin="{DynamicResource ColumnMargin}"
                FontWeight="SemiBold"
                Text="Is empty:" />

        </Grid>

        <ListView
            Grid.Row="2"
            Margin="2"
            Background="Transparent"
            ItemsSource="{Binding AvailableDrives}"
            SelectedItem="{Binding SelectedDrive}"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DriveColumn" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ModelColumn" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeColumn" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CapacityColumn" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="WriteStatusColumn" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="IsEmptyColumn" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Foreground="Gray"
                            Text="{Binding RootPath}" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="{DynamicResource ColumnMargin}"
                            Text="{Binding Model}" />

                        <TextBlock
                            Grid.Column="2"
                            Margin="{DynamicResource ColumnMargin}"
                            Text="{Binding VolumeLabel}" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="{DynamicResource ColumnMargin}"
                            Text="{Binding TotalSpace, Converter={StaticResource BytesToReadableSizeConverter}}" />

                        <TextBlock
                            Grid.Column="4"
                            Margin="{DynamicResource ColumnMargin}"
                            Text="{Binding WriteStatusText}" />

                        <TextBlock
                            Grid.Column="5"
                            Margin="{DynamicResource ColumnMargin}"
                            Text="{Binding IsEmptyText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button
            Grid.Row="3"
            Margin="0,10"
            Command="{Binding CopyDocumentsCommand}"
            Content="Copy documents" />

        <StackPanel Grid.Row="4">

            <TextBlock Margin="0,0,0,6" Text="{Binding CopyStatus}" />

            <ProgressBar
                Maximum="100"
                Minimum="0"
                Value="{Binding CopyProgress}" />

        </StackPanel>

    </Grid>
</UserControl>
