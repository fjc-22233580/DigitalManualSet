<Window
    x:Class="DigitalManualSet.App.Views.Dialogs.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DigitalManualSet.App.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    Height="250"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="4"
            Padding="0,6,0,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}"
            BorderThickness="{StaticResource ExpanderBorderThemeThickness}"
            CornerRadius="{StaticResource OverlayCornerRadius}">

            <TextBlock
                Margin="16,0,0,0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

        </Border>


        <Border
            Grid.Row="1"
            Margin="4"
            Padding="20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}"
            BorderThickness="{StaticResource ExpanderBorderThemeThickness}"
            CornerRadius="{StaticResource OverlayCornerRadius}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0" Text="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

                <DockPanel Grid.Row="1" HorizontalAlignment="Right">

                    <Button
                        x:Name="NoButton"
                        Margin="0,0,12,0"
                        IsCancel="True" />

                    <Button x:Name="YesButton" Click="YesButton_OnClick" />

                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
