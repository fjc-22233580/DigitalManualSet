<Window
    x:Class="DigitalManualSet.App.Views.Dialogs.AddDocumentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:DigitalManualSet.App.ViewModels.CreatePackage.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add Document"
    Width="600"
    Height="450"
    d:DataContext="{d:DesignInstance dialogs:AddDocumentDialogViewModel}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="4"
            Padding="0,6,0,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}"
            BorderThickness="{StaticResource ExpanderBorderThemeThickness}"
            CornerRadius="{StaticResource OverlayCornerRadius}">

            <TextBlock
                Margin="16,0,0,0"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Add Document" />

        </Border>


        <Border
            Grid.Row="1"
            Margin="4"
            Padding="20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}"
            BorderThickness="{StaticResource ExpanderBorderThemeThickness}"
            CornerRadius="{StaticResource OverlayCornerRadius}">



            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0">



                    <TextBlock Margin="2,0,0,4" Text="Document name:" />
                    <TextBox Margin="0,0,0,12" Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}" />


                    <TextBlock Margin="2,0,0,4" Text="Document file:" />

                    <DockPanel>
                        <Button
                            Margin="8,0,0,0"
                            Click="Browse_Click"
                            Content="Browse"
                            DockPanel.Dock="Right" />
                        <TextBox
                            DockPanel.Dock="Right"
                            IsEnabled="False"
                            Text="{Binding FilePath, Mode=OneWay}" />

                    </DockPanel>


                </StackPanel>

                <DockPanel Grid.Row="1" HorizontalAlignment="Right">

                    <Button
                        Margin="0,0,12,0"
                        Content="Cancel"
                        IsCancel="True" />

                    <Button
                        Click="Add_Click"
                        Content="Add Document"
                        IsDefault="True"
                        IsEnabled="{Binding CanAdd}" />

                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
